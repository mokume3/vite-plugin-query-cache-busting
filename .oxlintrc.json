{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["dist", "node_modules", "tests/fixtures"],
  "rules": {
    "require-unicode-regexp": "off"
  }
}
