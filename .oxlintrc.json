{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["dist", "node_modules", "tests/fixtures"],
  "rules": {
    "require-unicode-regexp": "off",
    "prefer-number-coercion": "off"
  },
  "overrides": [
    {
      "files": ["src/index.ts"],
      "rules": {
        "max-dependencies": "off",
        "prefer-type-error": "off"
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "require-await": "off",
        "no-useless-undefined": "off",
        "max-lines-per-function": "off"
      }
    }
  ]
}
